# Copia a .env  →  cp .env.example .env
# O genera todo con:  npm run real:init

NODE_ENV=production
REAL_MODE=1
SEED_DEMOS=0
PORT=3456

SITE_URL=https://www.tudominio.com
SITE_NAME=EscortBenidorm

# Obligatorios en producción (mín. 24 / 10 caracteres, no uses defaults)
JWT_SECRET=genera-cadena-larga-aleatoria-minimo-32-chars
ADMIN_USER=admin
ADMIN_PASSWORD=contraseña-muy-fuerte-aqui

# Datos legales (aparecen en aviso legal y privacidad)
OPERATOR_NAME=Nombre Apellidos o S.L.
OPERATOR_NIF=12345678A
OPERATOR_EMAIL=contacto@tudominio.com
OPERATOR_ADDRESS=Calle Ejemplo 1, 03501 Benidorm, Alicante, España

# Planes DIARIOS (EUR / día) — modelo 5 / 7 / 10
PLAN_DAY_PRICE=5
PLAN_BASIC_PRICE=5
PLAN_VIP_PRICE=7
PLAN_TOP_PRICE=10

# Datos de cobro (Bizum / transferencia)
PAY_BIZUM=600000000
PAY_IBAN=ES00 0000 0000 0000 0000 0000
PAY_HOLDER=Nombre del titular

# Activar plan al declarar pago sin revisión admin (solo si confías)
# AUTO_ACTIVATE_PAY=1

# Simular pago: SOLO local. En producción pon 0
ALLOW_MOCK_PAY=0

# Email opcional (nodemailer ya en package.json)
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@tudominio.com
# SMTP_TO=tu@email.com

# Stripe (opcional) — tarjeta en checkout
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Analytics (opcional) — solo si el usuario acepta cookies de medición
# GA_MEASUREMENT_ID=G-XXXXXXXX
